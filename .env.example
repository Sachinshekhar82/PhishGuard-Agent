# PhishGuard Agent Configuration
# LLM Enhancement (optional, off by default if no key is provided)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ENABLE_LLM_EXPLANATION=false

# Optional VirusTotal API key for benchmarking script ONLY (not used in detection pipeline)
VT_API_KEY=

# Server configuration
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./phishguard.db

# Detection weights (ML probability weight vs Heuristic score weight)
ML_WEIGHT=0.6
HEURISTIC_WEIGHT=0.4

# Risk score thresholds (0-100)
LEGITIMATE_THRESHOLD=34
PHISHING_THRESHOLD=65
